<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AquaTrip — Praias</title>
  <link rel="stylesheet" href="/css/praias.css" />
</head>
<body>

<%- include('../partials/header') %>

  <main class="main-layout">

    <!-- MENU LATERAL -->
    <aside class="sidebar" aria-label="Filtros de praias">
      <section class="sidebar-section">
        <a href="/" class="breadcrumb-link">← Voltar</a>
        <h2 class="sidebar-title">Praias</h2>
        <a href="/criar_experiencia" class="btn-criar-experiencia">Criar experiência</a>
        <nav class="filter-nav" aria-label="Filtros por região">
          <button class="filter-btn active" data-filter="todos" type="button">Todos</button>
          <button class="filter-btn" data-filter="brasil" type="button">Brasil</button>
        </nav>
      </section>

      <section class="sidebar-section">
        <h3 class="sidebar-subtitle">Avaliação mínima</h3>
        <fieldset class="star-filter">
          <legend class="sr-only">Filtrar por estrelas</legend>
          <label><input type="radio" name="stars" value="0" checked /> Todas</label>
          <label><input type="radio" name="stars" value="4" /> ★★★★+</label>
          <label><input type="radio" name="stars" value="4.5" /> ★★★★½+</label>
        </fieldset>
      </section>

      <section class="sidebar-section">
        <h3 class="sidebar-subtitle">Preço máximo</h3>
        <label for="price-range" class="sr-only">Preço máximo por pessoa</label>
        <input type="range" id="price-range" class="price-slider" min="100" max="500" step="20" value="500" />
        <output class="price-output" for="price-range">R$ 500+</output>
      </section>
    </aside>

    <!-- CONTEÚDO PRINCIPAL -->
    <section class="content-area" aria-label="Catálogo de praias">

      <!-- CARD DESTACADO -->
      <article class="card-featured" data-region="brasil" data-stars="4.9" data-price="420" aria-label="Destino em destaque">
        <figure class="card-featured-image">
          <img src="https://brasilien.de/wp-content/uploads/sites/51/2019/04/BRA_2007_6AVB_Fernando_de_Noronha-brasilien-strand-009-1000x664.jpg" alt="Praia em Fernando de Noronha, Pernambuco" loading="lazy" />
          <figcaption class="featured-badge">✦ Destino da Semana</figcaption>
        </figure>
        <section class="card-featured-body">
          <header class="card-featured-header">
            <span class="card-region-tag">Brasil</span>
            <h2 class="card-featured-title">Praia do Sancho e baías de Noronha</h2>
            <p class="card-featured-location">Fernando de Noronha, Pernambuco</p>
          </header>
          <p class="card-featured-desc">
            Passe um dia pelas enseadas preservadas do arquipélago, com guia local, paradas para banho e leitura da paisagem vulcânica.
          </p>
          <footer class="card-featured-footer">
            <section class="card-meta">
              <meter class="star-meter" min="0" max="5" value="4.9" title="Avaliação: 4.9 de 5"></meter>
              <output class="star-display" aria-label="Avaliação 4.9 de 5">★★★★★</output>
              <span class="reviews-count">4.9 · 328 avaliações</span>
              <small class="review-disclaimer">Avaliações fictícias para demonstração.</small>
            </section>
            <section class="card-price-block">
              <span class="price-label">A partir de</span>
              <strong class="price-value">R$ 420</strong>
              <span class="price-note">/ pessoa · dia completo</span>
            </section>
            <a href="/dados_pagamento"><button class="btn-ver-pacote" type="button">Ver experiência →</button></a>
          </footer>
        </section>
      </article>

      <!-- GRID DE CARDS -->
      <section class="cards-section" aria-label="Todas as praias">
        <header class="cards-header">
          <h2 class="cards-section-title">Explore Praias pelo Brasil</h2>
          <nav class="carousel-nav" aria-label="Navegação dos cards">
            <button class="arrow-btn" id="prev-btn" type="button" aria-label="Anteriores">&#8592;</button>
            <span class="page-indicator" id="page-indicator" aria-live="polite">1 / 3</span>
            <button class="arrow-btn" id="next-btn" type="button" aria-label="Próximos">&#8594;</button>
          </nav>
        </header>

        <ol class="cards-grid" id="cards-grid" role="list">

          <li class="card-item" data-region="brasil" data-stars="4.8" data-price="280">
            <article class="card">
              <figure class="card-thumb">
                <img src="/img/fernandonoronha.jpg" alt="Paisagem litorânea brasileira em Jericoacoara, Ceará" loading="lazy" />
                <figcaption class="card-region-tag">Brasil</figcaption>
              </figure>
              <section class="card-body">
                <header>
                  <h3 class="card-title">Lagoas e dunas de Jericoacoara</h3>
                  <p class="card-location">Jijoca de Jericoacoara, Ceará</p>
                </header>
                <p class="card-desc">Roteiro de dia inteiro entre a vila, lagoas de água doce e dunas do litoral oeste.</p>
                <footer class="card-footer">
                  <section class="card-stars" aria-label="Avaliação 4.8">
                    <output class="star-display sm">★★★★★</output>
                    <span class="star-num">4.8 · 214 avaliações</span>
                  </section>
                  <strong class="card-price">R$ 280</strong>
                </footer>
              </section>
            </article>
          </li>

          <li class="card-item" data-region="brasil" data-stars="4.7" data-price="260">
            <article class="card">
              <figure class="card-thumb">
                <img src="https://r2.luckreceptivo.com.br/8123/01JJMH99YSY863SDBGG3JEPXQK.jpg" alt="Praia de Maragogi, Alagoas" loading="lazy" />
                <figcaption class="card-region-tag">Brasil</figcaption>
              </figure>
              <section class="card-body">
                <header>
                  <h3 class="card-title">Piscinas naturais de Maragogi</h3>
                  <p class="card-location">Maragogi, Alagoas</p>
                </header>
                <p class="card-desc">Navegação até as galés na maré adequada, com tempo para observar os recifes e nadar.</p>
                <footer class="card-footer">
                  <section class="card-stars" aria-label="Avaliação 4.7">
                    <output class="star-display sm">★★★★</output>
                    <span class="star-num">4.7 · 187 avaliações</span>
                  </section>
                  <strong class="card-price">R$ 260</strong>
                </footer>
              </section>
            </article>
          </li>

          <li class="card-item" data-region="brasil" data-stars="4.8" data-price="310">
            <article class="card">
              <figure class="card-thumb">
                <img src="/img/cardume_peixes.avif" alt="Águas costeiras de Arraial do Cabo, Rio de Janeiro" loading="lazy" />
                <figcaption class="card-region-tag">Brasil</figcaption>
              </figure>
              <section class="card-body">
                <header>
                  <h3 class="card-title">Praias e mirantes de Arraial do Cabo</h3>
                  <p class="card-location">Arraial do Cabo, Rio de Janeiro</p>
                </header>
                <p class="card-desc">Passeio costeiro pelas águas claras da Região dos Lagos, com paradas em praias acessíveis por barco.</p>
                <footer class="card-footer">
                  <section class="card-stars" aria-label="Avaliação 4.8">
                    <output class="star-display sm">★★★★★</output>
                    <span class="star-num">4.8 · 256 avaliações</span>
                  </section>
                  <strong class="card-price">R$ 310</strong>
                </footer>
              </section>
            </article>
          </li>

          <li class="card-item" data-region="brasil" data-stars="4.6" data-price="240">
            <article class="card">
              <figure class="card-thumb">
                <img src="/img/fernandonoronha.jpg" alt="Praia dos Carneiros, Pernambuco" loading="lazy" />
                <figcaption class="card-region-tag">Brasil</figcaption>
              </figure>
              <section class="card-body">
                <header>
                  <h3 class="card-title">Dia leve na Praia dos Carneiros</h3>
                  <p class="card-location">Tamandaré, Pernambuco</p>
                </header>
                <p class="card-desc">Experiência tranquila entre coqueiros, banco de areia e a foz do Rio Formoso.</p>
                <footer class="card-footer">
                  <section class="card-stars" aria-label="Avaliação 4.6">
                    <output class="star-display sm">★★★★</output>
                    <span class="star-num">4.6 · 149 avaliações</span>
                  </section>
                  <strong class="card-price">R$ 240</strong>
                </footer>
              </section>
            </article>
          </li>

          <li class="card-item" data-region="brasil" data-stars="4.5" data-price="120">
            <article class="card">
              <figure class="card-thumb">
                <img src="/img/fernandonoronha.jpg" alt="Praia de Ipanema, Rio de Janeiro" loading="lazy" />
                <figcaption class="card-region-tag">Brasil</figcaption>
              </figure>
              <section class="card-body">
                <header>
                  <h3 class="card-title">Pôr do sol em Ipanema</h3>
                  <p class="card-location">Rio de Janeiro, Rio de Janeiro</p>
                </header>
                <p class="card-desc">Caminhada guiada pela orla para conhecer a história dos bairros e contemplar o entardecer.</p>
                <footer class="card-footer">
                  <section class="card-stars" aria-label="Avaliação 4.5">
                    <output class="star-display sm">★★★★</output>
                    <span class="star-num">4.5 · 93 avaliações</span>
                  </section>
                  <strong class="card-price">R$ 120</strong>
                </footer>
              </section>
            </article>
          </li>

          <li class="card-item" data-region="brasil" data-stars="4.7" data-price="190">
            <article class="card">
              <figure class="card-thumb">
                <img src="/img/observacao_baleias.jpg" alt="Litoral de Santa Catarina próximo à Praia do Rosa" loading="lazy" />
                <figcaption class="card-region-tag">Brasil</figcaption>
              </figure>
              <section class="card-body">
                <header>
                  <h3 class="card-title">Trilhas e mar da Praia do Rosa</h3>
                  <p class="card-location">Imbituba, Santa Catarina</p>
                </header>
                <p class="card-desc">Caminhada curta pela costa com paradas em mirantes e tempo livre para curtir a praia.</p>
                <footer class="card-footer">
                  <section class="card-stars" aria-label="Avaliação 4.7">
                    <output class="star-display sm">★★★★</output>
                    <span class="star-num">4.7 · 118 avaliações</span>
                  </section>
                  <strong class="card-price">R$ 190</strong>
                </footer>
              </section>
            </article>
          </li>

        </ol>

        <p class="no-results" id="no-results" hidden aria-live="polite">Nenhuma experiência encontrada com esses filtros.</p>
      </section>
    </section>

  </main>

  <%- include('../partials/footer') %>

  <script src="/js/aquarios.js"></script>
</body>
</html>
