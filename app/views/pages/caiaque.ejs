<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AquaTrip — Caiaque</title>
  <link rel="stylesheet" href="/css/caiaque.css" />
</head>
<body>

<%- include('../partials/header') %>

  <main class="main-layout">

    <!-- MENU LATERAL -->
    <aside class="sidebar" aria-label="Filtros de caiaque">
      <section class="sidebar-section">
        <a href="/" class="breadcrumb-link">← Voltar</a>
        <h2 class="sidebar-title">Caiaque</h2>
        <a href="/criar_experiencia" class="btn-criar-experiencia">Criar experiência</a>
        <nav class="filter-nav" aria-label="Filtros por região">
          <button class="filter-btn active" data-filter="todos" type="button">Todos</button>
          <button class="filter-btn" data-filter="brasil" type="button">Brasil</button>
        </nav>
      </section>

      <section class="sidebar-section">
        <h3 class="sidebar-subtitle">Avaliação mínima</h3>
        <fieldset class="star-filter">
          <legend class="sr-only">Filtrar por estrelas</legend>
          <label><input type="radio" name="stars" value="0" checked /> Todas</label>
          <label><input type="radio" name="stars" value="4" /> ★★★★+</label>
          <label><input type="radio" name="stars" value="4.5" /> ★★★★½+</label>
        </fieldset>
      </section>

      <section class="sidebar-section">
        <h3 class="sidebar-subtitle">Preço máximo</h3>
        <label for="price-range" class="sr-only">Preço máximo por pessoa</label>
        <input type="range" id="price-range" class="price-slider" min="100" max="350" step="10" value="350" />
        <output class="price-output" for="price-range">R$ 350+</output>
      </section>
    </aside>

    <!-- CONTEÚDO PRINCIPAL -->
    <section class="content-area" aria-label="Catálogo de caiaque">

      <!-- CARD DESTACADO -->
      <article class="card-featured" data-region="brasil" data-stars="4.8" data-price="220" aria-label="Destino em destaque">
        <figure class="card-featured-image">
          <img src="https://images.daytrip.com/paraty.jpg" alt="Caiaques na baía de Paraty, Rio de Janeiro" loading="lazy" />
          <figcaption class="featured-badge">✦ Remada da Semana</figcaption>
        </figure>
        <section class="card-featured-body">
          <header class="card-featured-header">
            <span class="card-region-tag">Brasil</span>
            <h2 class="card-featured-title">Caiaque pela Baía de Paraty</h2>
            <p class="card-featured-location">Paraty, Rio de Janeiro</p>
          </header>
          <p class="card-featured-desc">
            Remada guiada pelas águas calmas da baía, com orientação inicial e paradas para observar a costa verde e o centro histórico.
          </p>
          <footer class="card-featured-footer">
            <section class="card-meta">
              <meter class="star-meter" min="0" max="5" value="4.8" title="Avaliação: 4.8 de 5"></meter>
              <output class="star-display" aria-label="Avaliação 4.8 de 5">★★★★★</output>
              <span class="reviews-count">4.8 · 194 avaliações</span>
              <small class="review-disclaimer">Avaliações fictícias para demonstração.</small>
            </section>
            <section class="card-price-block">
              <span class="price-label">A partir de</span>
              <strong class="price-value">R$ 220</strong>
              <span class="price-note">/ pessoa · meio período</span>
            </section>
            <a href="/dados_pagamento"><button class="btn-ver-pacote" type="button">Ver experiência →</button></a>
          </footer>
        </section>
      </article>

      <!-- GRID DE CARDS -->
      <section class="cards-section" aria-label="Todas as experiências de caiaque">
        <header class="cards-header">
          <h2 class="cards-section-title">Explore Caiaque pelo Brasil</h2>
          <nav class="carousel-nav" aria-label="Navegação dos cards">
            <button class="arrow-btn" id="prev-btn" type="button" aria-label="Anteriores">&#8592;</button>
            <span class="page-indicator" id="page-indicator" aria-live="polite">1 / 3</span>
            <button class="arrow-btn" id="next-btn" type="button" aria-label="Próximos">&#8594;</button>
          </nav>
        </header>

        <ol class="cards-grid" id="cards-grid" role="list">

          <li class="card-item" data-region="brasil" data-stars="4.7" data-price="210">
            <article class="card">
              <figure class="card-thumb">
                <img src="https://3.bp.blogspot.com/-v-dRrYI_Ybs/UEO0Qy1e9hI/AAAAAAAAaM0/JflESWtYPbk/s1600/GOPR0154.jpg" alt="Caiaque no mar de Ilhabela, São Paulo" loading="lazy" />
                <figcaption class="card-region-tag">Brasil</figcaption>
              </figure>
              <section class="card-body">
                <header>
                  <h3 class="card-title">Remada ao pôr do sol em Ilhabela</h3>
                  <p class="card-location">Ilhabela, São Paulo</p>
                </header>
                <p class="card-desc">Passeio de caiaque em enseadas protegidas, acompanhado por instrutor e com pausa para contemplar a ilha.</p>
                <footer class="card-footer">
                  <section class="card-stars" aria-label="Avaliação 4.7">
                    <output class="star-display sm">★★★★</output>
                    <span class="star-num">4.7 · 133 avaliações</span>
                  </section>
                  <strong class="card-price">R$ 210</strong>
                </footer>
              </section>
            </article>
          </li>

          <li class="card-item" data-region="brasil" data-stars="4.8" data-price="240">
            <article class="card">
              <figure class="card-thumb">
                <img src="https://cdn.getyourguide.com/img/tour/62a2086e68749.png/146.jpg" alt="Caiaque em Paraty, Rio de Janeiro" loading="lazy" />
                <figcaption class="card-region-tag">Brasil</figcaption>
              </figure>
              <section class="card-body">
                <header>
                  <h3 class="card-title">Manguezais de Paraty-Mirim</h3>
                  <p class="card-location">Paraty, Rio de Janeiro</p>
                </header>
                <p class="card-desc">Rota de baixa intensidade pelos canais de mangue, com conversa sobre a fauna e a vegetação costeira.</p>
                <footer class="card-footer">
                  <section class="card-stars" aria-label="Avaliação 4.8">
                    <output class="star-display sm">★★★★★</output>
                    <span class="star-num">4.8 · 167 avaliações</span>
                  </section>
                  <strong class="card-price">R$ 240</strong>
                </footer>
              </section>
            </article>
          </li>

          <li class="card-item" data-region="brasil" data-stars="4.6" data-price="180">
            <article class="card">
              <figure class="card-thumb">
                <img src="/img/observacao_baleias.jpg" alt="Lagoa da Conceição em Florianópolis, Santa Catarina" loading="lazy" />
                <figcaption class="card-region-tag">Brasil</figcaption>
              </figure>
              <section class="card-body">
                <header>
                  <h3 class="card-title">Volta de caiaque na Lagoa da Conceição</h3>
                  <p class="card-location">Florianópolis, Santa Catarina</p>
                </header>
                <p class="card-desc">Remada em águas abrigadas com briefing de segurança e leitura das montanhas que cercam a lagoa.</p>
                <footer class="card-footer">
                  <section class="card-stars" aria-label="Avaliação 4.6">
                    <output class="star-display sm">★★★★</output>
                    <span class="star-num">4.6 · 101 avaliações</span>
                  </section>
                  <strong class="card-price">R$ 180</strong>
                </footer>
              </section>
            </article>
          </li>

          <li class="card-item" data-region="brasil" data-stars="4.7" data-price="270">
            <article class="card">
              <figure class="card-thumb">
                <img src="/img/fernandonoronha.jpg" alt="Ilhas de Angra dos Reis, Rio de Janeiro" loading="lazy" />
                <figcaption class="card-region-tag">Brasil</figcaption>
              </figure>
              <section class="card-body">
                <header>
                  <h3 class="card-title">Caiaque entre ilhas de Angra</h3>
                  <p class="card-location">Angra dos Reis, Rio de Janeiro</p>
                </header>
                <p class="card-desc">Roteiro guiado com ritmo leve pelas águas da Baía da Ilha Grande e pausa em uma praia.</p>
                <footer class="card-footer">
                  <section class="card-stars" aria-label="Avaliação 4.7">
                    <output class="star-display sm">★★★★</output>
                    <span class="star-num">4.7 · 114 avaliações</span>
                  </section>
                  <strong class="card-price">R$ 270</strong>
                </footer>
              </section>
            </article>
          </li>

          <li class="card-item" data-region="brasil" data-stars="4.8" data-price="320">
            <article class="card">
              <figure class="card-thumb">
                <img src="/img/expedicao_amazonica.png" alt="Manguezais do Delta do Parnaíba, Piauí" loading="lazy" />
                <figcaption class="card-region-tag">Brasil</figcaption>
              </figure>
              <section class="card-body">
                <header>
                  <h3 class="card-title">Canais do Delta do Parnaíba</h3>
                  <p class="card-location">Ilha Grande, Piauí</p>
                </header>
                <p class="card-desc">Remada pelos braços de rio e manguezais do delta, com foco na paisagem e nas aves da região.</p>
                <footer class="card-footer">
                  <section class="card-stars" aria-label="Avaliação 4.8">
                    <output class="star-display sm">★★★★★</output>
                    <span class="star-num">4.8 · 89 avaliações</span>
                  </section>
                  <strong class="card-price">R$ 320</strong>
                </footer>
              </section>
            </article>
          </li>

          <li class="card-item" data-region="brasil" data-stars="4.5" data-price="230">
            <article class="card">
              <figure class="card-thumb">
                <img src="/img/expedicao_amazonica.png" alt="Rio de águas claras na região de Bonito, Mato Grosso do Sul" loading="lazy" />
                <figcaption class="card-region-tag">Brasil</figcaption>
              </figure>
              <section class="card-body">
                <header>
                  <h3 class="card-title">Rio da Prata em Bonito</h3>
                  <p class="card-location">Jardim, Mato Grosso do Sul</p>
                </header>
                <p class="card-desc">Passeio em caiaque por águas calmas da região de Bonito, com acompanhamento e pausas para observação.</p>
                <footer class="card-footer">
                  <section class="card-stars" aria-label="Avaliação 4.5">
                    <output class="star-display sm">★★★★</output>
                    <span class="star-num">4.5 · 72 avaliações</span>
                  </section>
                  <strong class="card-price">R$ 230</strong>
                </footer>
              </section>
            </article>
          </li>

        </ol>

        <p class="no-results" id="no-results" hidden aria-live="polite">Nenhuma experiência encontrada com esses filtros.</p>
      </section>
    </section>

  </main>

  <%- include('../partials/footer') %>

  <script src="/js/aquarios.js"></script>
</body>
</html>
