  <!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AquaTrip — Expedições</title>
  <link rel="stylesheet" href="/css/expedicoes.css" />
</head>
<body>

<%- include('../partials/header') %>

<main class="main-layout">
  <!-- SIDEBAR -->
  <aside class="sidebar" aria-label="Filtros de expedições">

    <section class="sidebar-section">
      <a href="/" class="breadcrumb-link">← Voltar</a>

      <h2 class="sidebar-title">Expedições</h2>

      <a href="/criar_experiencia" class="btn-criar-experiencia">Criar experiência</a>

      <nav class="filter-nav" aria-label="Filtros por região">
        <button class="filter-btn active" data-filter="todos" type="button">Todos</button>
        <button class="filter-btn" data-filter="brasil" type="button">Brasil</button>
      </nav>
    </section>

    <section class="sidebar-section">
      <h3 class="sidebar-subtitle">Dificuldade</h3>

      <fieldset class="star-filter">
        <legend class="sr-only">Filtrar dificuldade</legend>

        <label><input type="radio" name="stars" value="0" checked /> Todas</label>
        <label><input type="radio" name="stars" value="4" /> Avançadas</label>
        <label><input type="radio" name="stars" value="4.5" /> Extremas</label>
      </fieldset>
    </section>

    <section class="sidebar-section">
      <h3 class="sidebar-subtitle">Preço máximo</h3>

      <input
        type="range"
        id="price-range"
        class="price-slider"
        min="3000"
        max="20000"
        step="1000"
        value="20000"
      />

      <output class="price-output">R$ 20.000+</output>
    </section>

  </aside>

  <!-- CONTENT -->
  <section class="content-area" aria-label="Catálogo de expedições">

    <!-- DESTAQUE -->
    <article
      class="card-featured"
      data-region="brasil"
      data-stars="5"
      data-price="18000"
    >

      <figure class="card-featured-image">
        <img
          src="/img/fernandonoronha.jpg"
          alt="Fernando de Noronha"
          loading="lazy"
        />

        <figcaption class="featured-badge">
          ✦ Expedição do Mês
        </figcaption>
      </figure>

      <section class="card-featured-body">

        <header class="card-featured-header">
          <span class="card-region-tag">Américas</span>

          <h2 class="card-featured-title">
            Fernando de Noronha
          </h2>

          <p class="card-featured-location">
            Brasil
          </p>
        </header>

        <p class="card-featured-desc">
          Explore este arquipélago vulcânico 
          brasileiro localizado no estado de Pernambuco. 
          Famoso por sua natureza intocada, praias paradisíacas 
          e santuário de vida marinha.
        </p>

        <footer class="card-featured-footer">

          <section class="card-meta">
            <output class="star-display">★★★★★</output>
            <span class="reviews-count">4.9 · 1.284 avaliações</span>
          </section>

          <section class="card-price-block">
            <span class="price-label">A partir de</span>
            <strong class="price-value">R$ 1.500</strong>
            <span class="price-note">/ pessoa · 10 dias</span>
          </section>

          <a href="/expedicoes">
            <button class="btn-ver-pacote" type="button">
              Ver expedição →
            </button>
          </a>

        </footer>

      </section>

    </article>

    <!-- GRID -->
    <section class="cards-section">

      <header class="cards-header">

        <h2 class="cards-section-title">
          Explore Aventuras pelo Brasil
        </h2>

        <nav class="carousel-nav">

          <button
            class="arrow-btn"
            id="prev-btn"
            type="button"
          >
            ←
          </button>

          <span class="page-indicator" id="page-indicator">
            1 / 3
          </span>

          <button
            class="arrow-btn"
            id="next-btn"
            type="button"
          >
            →
          </button>

        </nav>

      </header>

      <ol class="cards-grid" id="cards-grid" a href="/">

        <!-- CARD --> 
        <li class="card-item" data-region="brasil" data-stars="4.8" data-price="12000" a href="/">
          <article class="card">

            <figure class="card-thumb">
              <img
                src="/img/expedicao_amazonica.png"
                alt="Expedição na Amazônia" class="imagem"
              />
              <figcaption class="card-region-tag">América</figcaption>
            </figure>
        
            <section class="card-body" a href="/"> 

              <header>
                <h3 class="card-title">Expedição Amazônica</h3>
                <p class="card-location">Amazonas, Brasil</p>
              </header>

              <footer class="card-footer">

                <section class="card-stars">
                  <output class="star-display sm">★★★★★</output>
                  <span class="star-num">4.8</span>
                </section>

                <span class="reviews-count">· 218 avaliações</span><strong class="card-price">R$ 4.500</strong>

              </footer>

            </section>

          </article>
        </li>

        <!-- CARD -->
        <li class="card-item" data-region="brasil" data-stars="4.9" data-price="17000">
          <article class="card">

            <figure class="card-thumb">
              <img
                src="/img/observacao_baleias.jpg"
                alt="Observação de baleias no Brasil" class="imagem"
              />
              <figcaption class="card-region-tag">Brasil</figcaption>
            </figure>

            <section class="card-body">

              <header>
                <h3 class="card-title">Observação de Baleias — Santa Catarina</h3>
                <p class="card-location">Santa Catarina, Brasil</p>
              </header>

              <footer class="card-footer">

                <section class="card-stars">
                  <output class="star-display sm">★★★★★</output>
                  <span class="star-num">4.9</span>
                </section>

                <span class="reviews-count">· 164 avaliações</span><strong class="card-price">R$ 14.000</strong>

              </footer>

            </section>

          </article>
        </li>

        <!-- CARD -->
        <li class="card-item" data-region="brasil" data-stars="4.7" data-price="11000">
          <article class="card">

            <figure class="card-thumb">
              <img
                src="/img/fernandonoronha.jpg"
                alt="Ilhabela, Brasil" class="imagem"
              />
              <figcaption class="card-region-tag">Brasil</figcaption>
            </figure>

            <section class="card-body">

              <header>
                <h3 class="card-title">Caiaque e trilhas em Ilhabela</h3>
                <p class="card-location">Ilhabela, São Paulo</p>
              </header>

              <footer class="card-footer">

                <section class="card-stars">
                  <output class="star-display sm">★★★★</output>
                  <span class="star-num">4.7</span>
                </section>

                <span class="reviews-count">· 127 avaliações</span><strong class="card-price">R$ 10.500</strong>

              </footer>

            </section>

          </article>
        </li>

        <!-- CARD -->
        <li class="card-item" data-region="brasil" data-stars="4.6" data-price="13000">
          <article class="card">

            <figure class="card-thumb">
              <img
                src="/img/fernandonoronha.jpg"
                alt="Passeio de barco em Angra dos Reis" class="imagem"
              />
              <figcaption class="card-region-tag">Américas</figcaption>
            </figure>

            <section class="card-body">

              <header>
                <h3 class="card-title">Praias e ilhas de Angra dos Reis</h3>
                <p class="card-location">Angra dos Reis, Rio de Janeiro</p>
              </header>

              <footer class="card-footer">

                <section class="card-stars">
                  <output class="star-display sm">★★★★</output>
                  <span class="star-num">4.6</span>
                </section>

                <span class="reviews-count">· 98 avaliações</span><strong class="card-price">R$ 11.000</strong>

              </footer>

            </section>

          </article>
        </li>

        <!-- CARD -->
        <li class="card-item" data-region="brasil" data-stars="4.5" data-price="7000">
          <article class="card">

            <figure class="card-thumb">
              <img
                src="/img/cardume_peixes.avif"
                alt="Arraial do Cabo, Brasil" class="imagem"
              />
              <figcaption class="card-region-tag">Brasil</figcaption>
            </figure>

            <section class="card-body">

              <header>
                <h3 class="card-title">Mergulho em Arraial do Cabo</h3>
                <p class="card-location">Arraial do Cabo, Rio de Janeiro</p>
              </header>

              <footer class="card-footer">

                <section class="card-stars">
                  <output class="star-display sm">★★★★</output>
                  <span class="star-num">4.5</span>
                </section>

                <span class="reviews-count">· 203 avaliações</span><strong class="card-price">R$ 6.500</strong>

              </footer>

            </section>

          </article>
        </li>

        <!-- CARD -->
        <li class="card-item" data-region="brasil" data-stars="4.8" data-price="9000">
          <article class="card">

            <figure class="card-thumb">
              <img
                src="/img/expedicao_amazonica.png"
                alt="Bonito, Brasil" class="imagem"
              />
              <figcaption class="card-region-tag">Brasil</figcaption>
            </figure>

            <section class="card-body">

              <header>
                <h3 class="card-title">Rios e grutas de Bonito</h3>
                <p class="card-location">Bonito, Mato Grosso do Sul</p>
              </header>

              <footer class="card-footer">

                <section class="card-stars">
                  <output class="star-display sm">★★★★★</output>
                  <span class="star-num">4.8</span>
                </section>

                <span class="reviews-count">· 119 avaliações</span><strong class="card-price">R$ 8.000</strong>

              </footer>

            </section>

          </article>
        </li>

      </ol>

      <p class="no-results" id="no-results" hidden>
        Nenhuma expedição encontrada.
      </p>

    </section>

  </section>

</main>

<%- include('../partials/footer') %>

<script src="/js/expedicoes.js"></script>

</body>
</html>
