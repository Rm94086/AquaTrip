<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AquaTrip — Expedições</title>
  <link rel="stylesheet" href="/css/expedicoes.css" />
</head>
<body>

<%- include('../partials/header') %>
<a href="/" class="breadcrumb-link">← Voltar</a>
<main class="main-layout">
  <!-- SIDEBAR -->
  <aside class="sidebar" aria-label="Filtros de expedições">

    <section class="sidebar-section">
      <a href="/" class="breadcrumb-link">← Voltar para a home</a>

      <h2 class="sidebar-title">Expedições</h2>

      <nav class="filter-nav" aria-label="Filtros por região">
        <button class="filter-btn active" data-filter="todos" type="button">Todos</button>
        <button class="filter-btn" data-filter="america" type="button">América</button>
        <button class="filter-btn" data-filter="asia" type="button">Ásia</button>
        <button class="filter-btn" data-filter="africa" type="button">África</button>
        <button class="filter-btn" data-filter="oceania" type="button">Oceania</button>
      </nav>
    </section>

    <section class="sidebar-section">
      <h3 class="sidebar-subtitle">Dificuldade</h3>

      <fieldset class="star-filter">
        <legend class="sr-only">Filtrar dificuldade</legend>

        <label><input type="radio" name="stars" value="0" checked /> Todas</label>
        <label><input type="radio" name="stars" value="4" /> Avançadas</label>
        <label><input type="radio" name="stars" value="4.5" /> Extremas</label>
      </fieldset>
    </section>

    <section class="sidebar-section">
      <h3 class="sidebar-subtitle">Preço máximo</h3>

      <input
        type="range"
        id="price-range"
        class="price-slider"
        min="3000"
        max="20000"
        step="1000"
        value="20000"
      />

      <output class="price-output">R$ 20.000+</output>
    </section>

  </aside>

  <!-- CONTENT -->
  <section class="content-area" aria-label="Catálogo de expedições">

    <!-- DESTAQUE -->
    <article
      class="card-featured"
      data-region="africa"
      data-stars="5"
      data-price="18000"
    >

      <figure class="card-featured-image">
        <img
          src="/img/Monte_Kilimanjaro.webp"
          alt="Monte Kilimanjaro"
          loading="lazy"
        />

        <figcaption class="featured-badge">
          ✦ Expedição do Mês
        </figcaption>
      </figure>

      <section class="card-featured-body">

        <header class="card-featured-header">
          <span class="card-region-tag">África</span>

          <h2 class="card-featured-title">
            Kilimanjaro Expedition
          </h2>

          <p class="card-featured-location">
            Tanzânia
          </p>
        </header>

        <p class="card-featured-desc">
          Explore o ponto mais alto da África em uma jornada épica
          por trilhas vulcânicas, campos congelados e paisagens
          inacreditáveis. Uma experiência inesquecível para amantes
          da aventura.
        </p>

        <footer class="card-featured-footer">

          <section class="card-meta">
            <output class="star-display">★★★★★</output>
            <span class="reviews-count">(1.284 avaliações)</span>
          </section>

          <section class="card-price-block">
            <span class="price-label">A partir de</span>
            <strong class="price-value">R$ 15.000</strong>
            <span class="price-note">/ pessoa · 10 dias</span>
          </section>

          <a href="/produto-expedicao">
            <button class="btn-ver-pacote" type="button">
              Ver expedição →
            </button>
          </a>

        </footer>

      </section>

    </article>

    <!-- GRID -->
    <section class="cards-section">

      <header class="cards-header">

        <h2 class="cards-section-title">
          Explore Aventuras pelo Mundo
        </h2>

        <nav class="carousel-nav">

          <button
            class="arrow-btn"
            id="prev-btn"
            type="button"
          >
            ←
          </button>

          <span class="page-indicator" id="page-indicator">
            1 / 3
          </span>

          <button
            class="arrow-btn"
            id="next-btn"
            type="button"
          >
            →
          </button>

        </nav>

      </header>

      <ol class="cards-grid" id="cards-grid" a href="/">

        <!-- CARD --> 
        <li class="card-item" data-region="america" data-stars="4.8" data-price="12000" a href="/">
          <article class="card">

            <figure class="card-thumb">
              <img
                src="/img/trilha_inca.jfif"
                alt="Machu Picchu"
              />
              <figcaption class="card-region-tag">América</figcaption>
            </figure>
        
            <section class="card-body" a href="/"> 

              <header>
                <h3 class="card-title">Trilha Inca</h3>
                <p class="card-location">Peru</p>
              </header>

              <footer class="card-footer">

                <section class="card-stars">
                  <output class="star-display sm">★★★★★</output>
                  <span class="star-num">4.8</span>
                </section>

                <strong class="card-price">R$ 9.500</strong>

              </footer>

            </section>

          </article>
        </li>

        <!-- CARD -->
        <li class="card-item" data-region="asia" data-stars="4.9" data-price="17000">
          <article class="card">

            <figure class="card-thumb">
              <img
                src="/img/everest_base_camp.jfif"
                alt="Monte Everest"
              />
              <figcaption class="card-region-tag">Ásia</figcaption>
            </figure>

            <section class="card-body">

              <header>
                <h3 class="card-title">Everest Base Camp</h3>
                <p class="card-location">Nepal</p>
              </header>

              <footer class="card-footer">

                <section class="card-stars">
                  <output class="star-display sm">★★★★★</output>
                  <span class="star-num">4.9</span>
                </section>

                <strong class="card-price">R$ 14.000</strong>

              </footer>

            </section>

          </article>
        </li>

        <!-- CARD -->
        <li class="card-item" data-region="oceania" data-stars="4.7" data-price="11000">
          <article class="card">

            <figure class="card-thumb">
              <img
                src="/img/fiordes.jpg"
                alt="Nova Zelândia"
              />
              <figcaption class="card-region-tag">Oceania</figcaption>
            </figure>

            <section class="card-body">

              <header>
                <h3 class="card-title">Fiordes da Nova Zelândia</h3>
                <p class="card-location">Nova Zelândia</p>
              </header>

              <footer class="card-footer">

                <section class="card-stars">
                  <output class="star-display sm">★★★★½</output>
                  <span class="star-num">4.7</span>
                </section>

                <strong class="card-price">R$ 10.500</strong>

              </footer>

            </section>

          </article>
        </li>

        <!-- CARD -->
        <li class="card-item" data-region="africa" data-stars="4.6" data-price="13000">
          <article class="card">

            <figure class="card-thumb">
              <img
                src="/img/safari_quenia.jfif"
                alt="Safari no Quênia"
              />
              <figcaption class="card-region-tag">África</figcaption>
            </figure>

            <section class="card-body">

              <header>
                <h3 class="card-title">Safari Maasai Mara</h3>
                <p class="card-location">Quênia</p>
              </header>

              <footer class="card-footer">

                <section class="card-stars">
                  <output class="star-display sm">★★★★½</output>
                  <span class="star-num">4.6</span>
                </section>

                <strong class="card-price">R$ 11.000</strong>

              </footer>

            </section>

          </article>
        </li>

        <!-- CARD -->
        <li class="card-item" data-region="america" data-stars="4.5" data-price="7000">
          <article class="card">

            <figure class="card-thumb">
              <img
                src="/img/expedição_amazônica.jfif"
                alt="Amazônia"
              />
              <figcaption class="card-region-tag">América</figcaption>
            </figure>

            <section class="card-body">

              <header>
                <h3 class="card-title">Expedição Amazônica</h3>
                <p class="card-location">Brasil</p>
              </header>

              <footer class="card-footer">

                <section class="card-stars">
                  <output class="star-display sm">★★★★½</output>
                  <span class="star-num">4.5</span>
                </section>

                <strong class="card-price">R$ 6.500</strong>

              </footer>

            </section>

          </article>
        </li>

        <!-- CARD -->
        <li class="card-item" data-region="asia" data-stars="4.8" data-price="9000">
          <article class="card">

            <figure class="card-thumb">
              <img
                src="/img/selvas_tailândia.jfif"
                alt="Tailândia"
              />
              <figcaption class="card-region-tag">Ásia</figcaption>
            </figure>

            <section class="card-body">

              <header>
                <h3 class="card-title">Selvas da Tailândia</h3>
                <p class="card-location">Tailândia</p>
              </header>

              <footer class="card-footer">

                <section class="card-stars">
                  <output class="star-display sm">★★★★★</output>
                  <span class="star-num">4.8</span>
                </section>

                <strong class="card-price">R$ 8.000</strong>

              </footer>

            </section>

          </article>
        </li>

      </ol>

      <p class="no-results" id="no-results" hidden>
        Nenhuma expedição encontrada.
      </p>

    </section>

  </section>

</main>

<footer class="site-footer">
  <p>
    © 2026 AquaTrip · Todos os direitos reservados
  </p>
</footer>

<script src="/js/expedicoes.js"></script>

</body>
</html>