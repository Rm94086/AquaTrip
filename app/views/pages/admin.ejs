<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Aqua Trip — Painel Admin</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>

  <section class="admin-wrap">

    <!-- SIDEBAR -->
    <aside class="sidebar" aria-label="Menu lateral">
      <header class="sidebar-header">
        <section class="logo-mark">
          <span class="logo-icon" aria-hidden="true"><i class="ti ti-droplet"></i></span>
          <section>
            <strong class="logo-text">Aqua Trip</strong>
            <small class="logo-sub">Admin Panel</small>
          </section>
        </section>
      </header>

      <nav class="sidebar-nav" aria-label="Navegação principal">
        <p class="nav-label">Visão Geral</p>
        <button class="nav-item active" data-section="dashboard" aria-current="page">
          <i class="ti ti-layout-dashboard" aria-hidden="true"></i> Dashboard
        </button>

        <p class="nav-label">Gerenciar</p>
        <button class="nav-item" data-section="usuarios">
          <i class="ti ti-users" aria-hidden="true"></i> Usuários
        </button>
        <button class="nav-item" data-section="pacotes">
          <i class="ti ti-package" aria-hidden="true"></i> Pacotes
        </button>
        <button class="nav-item" data-section="faturamento">
          <i class="ti ti-receipt" aria-hidden="true"></i> Faturamento
        </button>
      </nav>
    </aside>

    <!-- MAIN -->
    <section class="main">

      <!-- TOPBAR -->
      <header class="topbar" role="banner">
        <h1 class="page-title" id="page-title">Dashboard</h1>
        <section class="topbar-right">
          <span class="avatar" aria-label="Administrador">AD</span>
        </section>
      </header>

      <main class="content" id="main-content">

        <!-- DASHBOARD -->
        <section class="section active" id="section-dashboard" aria-label="Dashboard">

          <section class="metrics" role="list">
            <article class="metric-card" role="listitem">
              <p class="metric-label"><i class="ti ti-users" aria-hidden="true"></i> Usuários</p>
              <strong class="metric-value">1.284</strong>
              <p class="metric-delta up">↑ 12% este mês</p>
            </article>
            <article class="metric-card" role="listitem">
              <p class="metric-label"><i class="ti ti-package" aria-hidden="true"></i> Pacotes ativos</p>
              <strong class="metric-value">8</strong>
              <p class="metric-delta up">↑ 2 novos</p>
            </article>
            <article class="metric-card" role="listitem">
              <p class="metric-label"><i class="ti ti-cash" aria-hidden="true"></i> Receita mensal</p>
              <strong class="metric-value">R$ 84.320</strong>
              <p class="metric-delta up">↑ 8% vs mês anterior</p>
            </article>
            <article class="metric-card" role="listitem">
              <p class="metric-label"><i class="ti ti-shopping-cart" aria-hidden="true"></i> Reservas</p>
              <strong class="metric-value">342</strong>
              <p class="metric-delta down">↓ 3% esta semana</p>
            </article>
          </section>

          <article class="card">
            <header class="card-header">
              <h2 class="card-title">Receita por pacote (mês atual)</h2>
            </header>
            <section class="chart-bar-wrap" aria-label="Gráfico de receita por pacote">
              <section class="bar-row"><span class="bar-label">Arraial do Cabo</span><section class="bar-track"><section class="bar-fill" style="width:88%"></section></section><span class="bar-val">R$ 24.800</span></section>
              <section class="bar-row"><span class="bar-label">Fernando Noronha</span><section class="bar-track"><section class="bar-fill" style="width:72%"></section></section><span class="bar-val">R$ 20.300</span></section>
              <section class="bar-row"><span class="bar-label">Ilhéus</span><section class="bar-track"><section class="bar-fill" style="width:54%"></section></section><span class="bar-val">R$ 15.200</span></section>
              <section class="bar-row"><span class="bar-label">Angra dos Reis</span><section class="bar-track"><section class="bar-fill" style="width:38%"></section></section><span class="bar-val">R$ 10.700</span></section>
              <section class="bar-row"><span class="bar-label">Bonito</span><section class="bar-track"><section class="bar-fill" style="width:22%"></section></section><span class="bar-val">R$ 6.200</span></section>
              <section class="bar-row"><span class="bar-label">Outros</span><section class="bar-track"><section class="bar-fill" style="width:14%"></section></section><span class="bar-val">R$ 7.120</span></section>
            </section>
          </article>

          <article class="card">
            <header class="card-header">
              <h2 class="card-title">Últimas reservas</h2>
            </header>
            <section class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th scope="col">Cliente</th>
                    <th scope="col">Pacote</th>
                    <th scope="col">Data</th>
                    <th scope="col">Valor</th>
                    <th scope="col">Status</th>
                  </tr>
                </thead>
                <tbody>
                  <tr><td>Camila Mendes</td><td>Arraial do Cabo</td><td>23 mai 2026</td><td>R$ 1.890</td><td><span class="badge badge-success">Confirmado</span></td></tr>
                  <tr><td>Rafael Torres</td><td>Fernando Noronha</td><td>22 mai 2026</td><td>R$ 4.200</td><td><span class="badge badge-warning">Pendente</span></td></tr>
                  <tr><td>Beatriz Lima</td><td>Bonito</td><td>21 mai 2026</td><td>R$ 2.350</td><td><span class="badge badge-success">Confirmado</span></td></tr>
                  <tr><td>Lucas Araujo</td><td>Ilhéus</td><td>20 mai 2026</td><td>R$ 1.600</td><td><span class="badge badge-danger">Cancelado</span></td></tr>
                </tbody>
              </table>
            </section>
          </article>
        </section>

        <!-- USUÁRIOS -->
        <section class="section" id="section-usuarios" aria-label="Lista de usuários">
          <header class="section-header">
            <h2 class="section-title">Lista de usuários</h2>
            <button class="btn btn-primary btn-sm"><i class="ti ti-plus" aria-hidden="true"></i> Novo usuário</button>
          </header>

          <search class="search-bar">
            <label for="user-search" class="sr-only">Buscar usuário</label>
            <i class="ti ti-search search-icon" aria-hidden="true"></i>
            <input type="search" id="user-search" placeholder="Buscar por nome ou e-mail..." autocomplete="off">
          </search>

          <article class="card">
            <section class="table-wrap">
              <table id="user-table" aria-label="Tabela de usuários">
                <thead>
                  <tr>
                    <th scope="col">#</th>
                    <th scope="col">Nome</th>
                    <th scope="col">E-mail</th>
                    <th scope="col">Cadastro</th>
                    <th scope="col">Reservas</th>
                    <th scope="col">Status</th>
                    <th scope="col">Ações</th>
                  </tr>
                </thead>
                <tbody id="user-tbody"></tbody>
              </table>
            </section>
          </article>
        </section>

        <!-- PACOTES -->
        <section class="section" id="section-pacotes" aria-label="Pacotes de viagem">
          <header class="section-header">
            <h2 class="section-title">Pacotes de viagem</h2>
            <button class="btn btn-primary btn-sm" id="btn-novo-pacote">
              <i class="ti ti-plus" aria-hidden="true"></i> Novo pacote
            </button>
          </header>

          <article class="card card-overflow">
            <ul class="pkg-grid" id="pkg-grid" aria-label="Lista de pacotes"></ul>
          </article>
        </section>

        <!-- FATURAMENTO -->
        <section class="section" id="section-faturamento" aria-label="Faturamento">

          <section class="metrics metrics-3" role="list">
            <article class="metric-card" role="listitem">
              <p class="metric-label"><i class="ti ti-trending-up" aria-hidden="true"></i> Total 2026</p>
              <strong class="metric-value">R$ 512.840</strong>
              <p class="metric-delta up">↑ 24% vs 2025</p>
            </article>
            <article class="metric-card" role="listitem">
              <p class="metric-label"><i class="ti ti-calendar" aria-hidden="true"></i> Maio 2026</p>
              <strong class="metric-value">R$ 84.320</strong>
              <p class="metric-delta up">↑ 8% vs abril</p>
            </article>
            <article class="metric-card" role="listitem">
              <p class="metric-label"><i class="ti ti-credit-card" aria-hidden="true"></i> Ticket médio</p>
              <strong class="metric-value">R$ 2.468</strong>
              <p class="metric-delta up">↑ R$ 142 vs mês ant.</p>
            </article>
          </section>

          <article class="card">
            <header class="card-header">
              <h2 class="card-title">Histórico de transações</h2>
              <section class="card-header-actions">
                <label for="filter-month" class="sr-only">Filtrar por mês</label>
                <select id="filter-month">
                  <option>Todos os meses</option>
                  <option selected>Maio 2026</option>
                  <option>Abril 2026</option>
                  <option>Março 2026</option>
                </select>
                <button class="btn btn-sm"><i class="ti ti-download" aria-hidden="true"></i> Exportar</button>
              </section>
            </header>
            <section class="table-wrap">
              <table aria-label="Transações">
                <thead>
                  <tr>
                    <th scope="col">ID</th>
                    <th scope="col">Cliente</th>
                    <th scope="col">Pacote</th>
                    <th scope="col">Data</th>
                    <th scope="col">Método</th>
                    <th scope="col">Valor</th>
                    <th scope="col">Status</th>
                  </tr>
                </thead>
                <tbody id="billing-tbody"></tbody>
              </table>
            </section>
          </article>

          <article class="card">
            <header class="card-header">
              <h2 class="card-title">Faturamento mensal — 2026</h2>
            </header>
            <section class="chart-bar-wrap" aria-label="Gráfico mensal 2026">
              <section class="bar-row"><span class="bar-label">Janeiro</span><section class="bar-track"><section class="bar-fill" style="width:48%"></section></section><span class="bar-val">R$ 67.200</span></section>
              <section class="bar-row"><span class="bar-label">Fevereiro</span><section class="bar-track"><section class="bar-fill" style="width:52%"></section></section><span class="bar-val">R$ 72.800</span></section>
              <section class="bar-row"><span class="bar-label">Março</span><section class="bar-track"><section class="bar-fill" style="width:57%"></section></section><span class="bar-val">R$ 79.500</span></section>
              <section class="bar-row"><span class="bar-label">Abril</span><section class="bar-track"><section class="bar-fill" style="width:56%"></section></section><span class="bar-val">R$ 78.100</span></section>
              <section class="bar-row"><span class="bar-label">Maio</span><section class="bar-track"><section class="bar-fill" style="width:60%"></section></section><span class="bar-val">R$ 84.320</span></section>
            </section>
          </article>
        </section>

      </main>
    </section>
  </section>

  <!-- MODAL PACOTE -->
  <dialog id="pkg-modal" aria-labelledby="modal-pkg-title" aria-modal="true">
    <article class="modal">
      <header class="modal-header">
        <h2 class="modal-title" id="modal-pkg-title">Novo pacote</h2>
        <button class="btn btn-sm" id="btn-close-modal" aria-label="Fechar modal">
          <i class="ti ti-x" aria-hidden="true"></i>
        </button>
      </header>
      <section class="modal-body">
        <form id="pkg-form" novalidate>
          <section class="form-group">
            <label for="pkg-nome">Nome do pacote</label>
            <input type="text" id="pkg-nome" placeholder="Ex: Arraial do Cabo — 5 dias" required>
          </section>
          <section class="form-group">
            <label for="pkg-preco">Preço (R$)</label>
            <input type="number" id="pkg-preco" placeholder="Ex: 1890" required>
          </section>
          <section class="form-group">
            <label for="pkg-destino">Destino</label>
            <input type="text" id="pkg-destino" placeholder="Ex: Rio de Janeiro, RJ">
          </section>
          <section class="form-group">
            <label for="pkg-desc">Descrição</label>
            <textarea id="pkg-desc" placeholder="Descreva o pacote, atividades incluídas..."></textarea>
          </section>
          <section class="form-group">
            <label>Imagem do pacote</label>
            <button type="button" class="img-preview" id="img-preview" aria-label="Clique para enviar imagem">
              <i class="ti ti-photo" aria-hidden="true"></i>
              <span>Clique para enviar imagem</span>
            </button>
            <input type="file" id="pkg-img-file" accept="image/*" aria-label="Arquivo de imagem">
          </section>
          <input type="hidden" id="pkg-edit-index">
        </form>
      </section>
      <footer class="modal-footer">
        <button class="btn" id="btn-cancel-modal">Cancelar</button>
        <button class="btn btn-primary" id="btn-save-pkg">
          <i class="ti ti-check" aria-hidden="true"></i> Salvar pacote
        </button>
      </footer>
    </article>
  </dialog>

  <!-- MODAL CONFIRMAÇÃO DELETE -->
  <dialog id="confirm-modal" aria-labelledby="confirm-title" aria-modal="true">
    <article class="confirm-box">
      <i class="ti ti-alert-triangle confirm-icon" aria-hidden="true"></i>
      <h2 class="confirm-text" id="confirm-title">Excluir este pacote?</h2>
      <p class="confirm-sub">Esta ação não pode ser desfeita.</p>
      <footer class="confirm-actions">
        <button class="btn" id="btn-cancel-delete">Cancelar</button>
        <button class="btn btn-danger" id="btn-confirm-delete">
          <i class="ti ti-trash" aria-hidden="true"></i> Excluir
        </button>
      </footer>
    </article>
  </dialog>

  <script src="/js/admin.js"></script>
</body>
</html>
